project_name = "cpemon"
environment  = "dev"
aws_region   = "eu-north-1"
aws_profile  = "cpemon-terraform"

github_repository = "huangruidtu/cpemon-mvp"

eks_cluster_name = "cpemon-dev"
vpc_cidr_block   = "10.40.0.0/16"

eks_cluster_version          = null
eks_endpoint_public_access   = true
eks_endpoint_private_access  = false
eks_bootstrap_cluster_creator_admin_permissions = false
eks_node_group_name          = "cpemon-dev-ng-main"
eks_node_capacity_type       = "ON_DEMAND"
eks_node_instance_types      = ["t3.small"]
eks_node_disk_size           = 20
eks_node_desired_size        = 1
eks_node_min_size            = 1
eks_node_max_size            = 2
eks_node_max_unavailable     = 1

eks_access_entries = {
  cpemon_terraform_admin = {
    principal_arn = "arn:aws:iam::701573843911:role/aws-reserved/sso.amazonaws.com/eu-north-1/AWSReservedSSO_CPEmonTerraformBootstrap_0241ccdc62503c71"
    policy_associations = {
      cluster_admin = {
        policy_arn = "arn:aws:eks::aws:cluster-access-policy/AmazonEKSClusterAdminPolicy"
        access_scope = {
          type = "cluster"
        }
      }
    }
  }
}

subnet_availability_zones = [
  "eu-north-1a",
  "eu-north-1b",
  "eu-north-1c",
]

public_subnet_cidr_blocks = [
  "10.40.0.0/24",
  "10.40.1.0/24",
  "10.40.2.0/24",
]

private_subnet_cidr_blocks = [
  "10.40.10.0/24",
  "10.40.11.0/24",
  "10.40.12.0/24",
]
