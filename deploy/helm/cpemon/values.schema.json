{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "CPEmon Helm values",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "global": {
      "type": "object",
      "properties": {
        "namespaceOverride": { "type": "string" },
        "imageRegistry": { "type": "string", "minLength": 1 },
        "imageTag": { "type": "string", "minLength": 1 },
        "imagePullPolicy": {
          "type": "string",
          "enum": ["Always", "IfNotPresent", "Never"]
        },
        "imagePullSecrets": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name"],
            "properties": {
              "name": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "workloads": {
      "type": "object",
      "required": ["cpemonApi", "acsIngest", "cpemonWriter"],
      "properties": {
        "cpemonApi": { "$ref": "#/definitions/workload" },
        "acsIngest": { "$ref": "#/definitions/workload" },
        "cpemonWriter": { "$ref": "#/definitions/workload" }
      }
    },
    "appConfig": {
      "type": "object",
      "properties": {
        "configMap": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "name": { "type": "string", "minLength": 1 }
          }
        },
        "httpAddr": { "type": "string", "minLength": 1 },
        "grafanaHomeUrl": { "type": "string" },
        "grafanaSnDashboardUrlTemplate": { "type": "string" },
        "kibanaHomeUrl": { "type": "string" },
        "kibanaSnLogsUrlTemplate": { "type": "string" },
        "kafkaBootstrapServers": { "type": "string", "minLength": 1 },
        "kafkaTopicDeviceHeartbeat": { "type": "string", "minLength": 1 },
        "kafkaTopicWanStatus": { "type": "string", "minLength": 1 },
        "kafkaTopicDeadletter": { "type": "string", "minLength": 1 },
        "kafkaProducerEnabled": { "type": "boolean" },
        "kafkaProducerTimeout": { "type": "string", "minLength": 1 },
        "kafkaProducerMaxRetries": { "type": "string", "pattern": "^[1-9][0-9]*$" },
        "kafkaConsumerEnabled": { "type": "boolean" },
        "kafkaConsumerGroupId": { "type": "string", "minLength": 1 },
        "kafkaConsumerReadTimeout": { "type": "string", "minLength": 1 },
        "kafkaConsumerCommitTimeout": { "type": "string", "minLength": 1 },
        "kafkaConsumerMaxRetries": { "type": "string", "pattern": "^[1-9][0-9]*$" },
        "kafkaConsumerRetryBackoff": { "type": "string", "minLength": 1 }
      }
    },
    "mysql": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "name": { "type": "string", "minLength": 1 },
        "replicaCount": { "type": "integer", "minimum": 0 },
        "image": {
          "type": "object",
          "required": ["repository", "tag", "pullPolicy"],
          "properties": {
            "repository": { "type": "string", "minLength": 1 },
            "tag": { "type": "string", "minLength": 1 },
            "pullPolicy": {
              "type": "string",
              "enum": ["Always", "IfNotPresent", "Never"]
            }
          }
        },
        "service": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "type": { "type": "string" },
            "port": { "type": "integer", "minimum": 1, "maximum": 65535 }
          }
        },
        "authSecret": {
          "type": "object",
          "required": ["name", "rootPasswordKey", "usernameKey", "passwordKey", "databaseKey"],
          "properties": {
            "name": { "type": "string", "minLength": 1 },
            "rootPasswordKey": { "type": "string", "minLength": 1 },
            "usernameKey": { "type": "string", "minLength": 1 },
            "passwordKey": { "type": "string", "minLength": 1 },
            "databaseKey": { "type": "string", "minLength": 1 }
          }
        },
        "configMap": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "name": { "type": "string", "minLength": 1 },
            "data": { "type": "object" }
          }
        },
        "persistence": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "create": { "type": "boolean" },
            "claimName": { "type": "string" },
            "accessModes": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 }
            },
            "size": { "type": "string", "minLength": 1 },
            "storageClassName": { "type": "string" }
          }
        },
        "probes": { "type": "object" },
        "resources": { "type": "object" }
      }
    },
    "externalSecrets": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "apiVersion": { "type": "string", "minLength": 1 },
        "refreshInterval": { "type": "string", "minLength": 1 },
        "store": {
          "type": "object",
          "required": ["create", "kind", "name", "provider"],
          "properties": {
            "create": { "type": "boolean" },
            "kind": { "type": "string", "enum": ["SecretStore", "ClusterSecretStore"] },
            "name": { "type": "string", "minLength": 1 },
            "provider": {
              "type": "object",
              "required": ["aws"],
              "properties": {
                "aws": {
                  "type": "object",
                  "required": ["service", "region"],
                  "properties": {
                    "service": { "type": "string", "enum": ["SecretsManager", "ParameterStore"] },
                    "region": { "type": "string", "minLength": 1 },
                    "roleArn": { "type": "string" }
                  }
                }
              }
            }
          }
        },
        "secrets": {
          "type": "object",
          "additionalProperties": { "$ref": "#/definitions/externalSecret" }
        }
      }
    },
    "defaults": {
      "type": "object",
      "properties": {
        "service": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "type": { "type": "string" },
            "annotations": { "type": "object" }
          }
        },
        "resources": { "type": "object" },
        "env": { "type": "array" },
        "envFrom": { "type": "array" }
      }
    },
    "ingress": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "className": { "type": "string" },
        "host": { "type": "string" },
        "annotations": { "type": "object" },
        "paths": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["path", "pathType", "workload", "port"],
            "properties": {
              "path": { "type": "string", "minLength": 1 },
              "pathType": { "type": "string", "enum": ["Exact", "Prefix", "ImplementationSpecific"] },
              "workload": { "type": "string", "minLength": 1 },
              "port": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "networkPolicy": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "mode": { "type": "string" },
        "defaultDenyEgress": { "type": "boolean" },
        "allowDnsEgress": { "type": "boolean" },
        "coreWorkloads": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "mysql": { "$ref": "#/definitions/networkPolicyDestination" },
        "monitoring": { "$ref": "#/definitions/networkPolicyNamespacePort" },
        "logging": { "$ref": "#/definitions/networkPolicyNamespacePort" }
      }
    },
    "pdb": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "minAvailable": {
          "oneOf": [
            { "type": "integer", "minimum": 0 },
            { "type": "string", "pattern": "^[0-9]+%$" }
          ]
        },
        "workloads": { "type": "object" }
      }
    },
    "serviceMonitor": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "name": { "type": "string", "minLength": 1 },
        "namespace": { "type": "string", "minLength": 1 },
        "releaseLabel": { "type": "string", "minLength": 1 },
        "interval": { "type": "string", "minLength": 1 },
        "scrapeTimeout": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 }
      }
    }
  },
  "definitions": {
    "workload": {
      "type": "object",
      "required": ["enabled", "name", "replicaCount", "image"],
      "properties": {
        "enabled": { "type": "boolean" },
        "name": { "type": "string", "minLength": 1 },
        "component": { "type": "string", "minLength": 1 },
        "replicaCount": { "type": "integer", "minimum": 0 },
        "image": {
          "type": "object",
          "required": ["repository"],
          "properties": {
            "repository": { "type": "string", "minLength": 1 },
            "tag": { "type": "string" },
            "pullPolicy": {
              "type": "string",
              "enum": ["", "Always", "IfNotPresent", "Never"]
            }
          }
        },
        "rollout": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "strategy": { "type": "string", "enum": ["canary"] },
            "canary": {
              "type": "object",
              "properties": {
                "steps": { "type": "array" }
              }
            }
          }
        },
        "env": {
          "type": "array",
          "items": { "$ref": "#/definitions/envVar" }
        },
        "secretEnv": {
          "type": "array",
          "items": { "$ref": "#/definitions/secretEnvVar" }
        }
      }
    },
    "envVar": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "value": { "type": "string" },
        "valueFromConfig": { "type": "string" }
      },
      "oneOf": [
        { "required": ["value"] },
        { "required": ["valueFromConfig"] }
      ]
    },
    "secretEnvVar": {
      "type": "object",
      "required": ["name", "secretName", "secretKey"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "secretName": { "type": "string", "minLength": 1 },
        "secretKey": { "type": "string", "minLength": 1 }
      }
    },
    "externalSecret": {
      "type": "object",
      "required": ["enabled", "name", "targetName", "creationPolicy", "remoteKey", "data"],
      "properties": {
        "enabled": { "type": "boolean" },
        "name": { "type": "string", "minLength": 1 },
        "targetName": { "type": "string", "minLength": 1 },
        "creationPolicy": { "type": "string", "minLength": 1 },
        "remoteKey": { "type": "string", "minLength": 1 },
        "data": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["secretKey"],
            "properties": {
              "secretKey": { "type": "string", "minLength": 1 },
              "remoteProperty": { "type": "string" },
              "remoteVersion": { "type": "string" }
            }
          }
        }
      }
    },
    "networkPolicyNamespacePort": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "namespace": { "type": "string", "minLength": 1 },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 }
      }
    },
    "networkPolicyDestination": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "namespace": { "type": "string", "minLength": 1 },
        "podLabels": { "type": "object" },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 }
      }
    }
  }
}
